# Public URL of this storefront deploy, used for link previews and share links.
# On Vercel it defaults to the deploy's own address (the production domain, or the preview's branch address).
NEXT_PUBLIC_SITE_URL=https://kate.suppliafya.co.ke

# Which storefront "/" shows. Every storefront is also served at /<slug>.
NEXT_PUBLIC_DEFAULT_STOREFRONT=kate

# Optional. The Suppli Afya app this storefront reports to (its production address). For live storefronts
# with a suppliSlug: selector results the customer sends are saved as a prospect (POST <url>/api/leads)
# and orders are filed in the distributor's Orders and Today (POST <url>/api/storefront/orders).
SUPPLI_AFYA_URL=
# The same long random string as the app's STOREFRONT_SECRET. Without it, orders aren't filed.
STOREFRONT_SECRET=

# Optional. This storefront's own database: the Supabase project suppli_afya-template_site, never the
# app's. Orders the app can't take right away wait here (at most 7 days) and are sent again. Transaction
# pooler, as the storefront's own user storefront_app (see README, "Deploying"):
# postgres://storefront_app.aqnscgqcudjklburietu:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
# Secret the scheduler sends to /api/cron/orders (Vercel Cron sends it automatically when set in the project).
CRON_SECRET=

# Optional. Every order placed on the storefront is POSTed here as JSON (after the server has
# re-priced it), e.g. to feed a spreadsheet or a chat channel.
ORDER_WEBHOOK_URL=
